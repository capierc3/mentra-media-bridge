<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 11 22H2+ (Live Captions). The Windows SDK target gives us the now-playing API. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <!-- Pulls in System.Windows.Automation (UI Automation client), used to read Live Captions. -->
    <UseWPF>true</UseWPF>
    <!-- The tray icon and its menu. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PcCaptionBridge</AssemblyName>
    <RootNamespace>PcCaptionBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Made by running the app with the write-icon option (same drawing as the tray icon). -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
